<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FT8215Debugger.uc_2HallICCoolFan_s2" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="830" xmlns:ft8215debugger="clr-namespace:FT8215Debugger" Loaded="UserControl_Loaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="150" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <GroupBox Grid.Row="0" Grid.Column="0" Header="FG &amp; RD" Margin="0,0,5,0">
      <Grid Margin="0,5,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="70" />
          <ColumnDefinition />
          <ColumnDefinition Width="70" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">FGDIV</Label>
        <ComboBox Name="comboBox_FgDiv" Grid.Row="0" Grid.Column="1" Width="80" Height="23" HorizontalAlignment="Left" />
        <Label Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">FGMUL</Label>
        <ComboBox Name="comboBox_FgMul" Grid.Row="0" Grid.Column="3" Width="80" Height="23" HorizontalAlignment="Left" />
        <Label Grid.Row="2" VerticalAlignment="Center">FGRD__MD</Label>
        <ComboBox Name="comboBox_FgRdMd" Grid.Row="2" Grid.Column="1" Width="80" Height="23" HorizontalAlignment="Left" />
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Grid.Column="0" Header="RSD" Height="100" Margin="0,5,5,0" VerticalAlignment="Top">
      <Grid Margin="0,5,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label VerticalAlignment="Center">StaticSpeed</Label>
        <BulletDecorator Grid.Column="1" VerticalAlignment="Center">
          <BulletDecorator.Bullet>
            <Slider Name="slider_StaticSpeed" Width="250" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
          </BulletDecorator.Bullet>
          <TextBlock Name="textBlock_StaticSpeed" Foreground="#FF000000" />
        </BulletDecorator>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="0" Grid.Column="1" Header="SpeedCtrl" Margin="0,0,5,0">
      <Grid Margin="0,5,0,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label VerticalAlignment="Center">SpdCtrlMode</Label>
        <ComboBox Name="comboBox_SpdCtrlMD" Grid.Column="1" Width="80" Height="23" HorizontalAlignment="Left" />
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Grid.Column="0" Header="Protection" Margin="0,105,5,0" Height="200" VerticalAlignment="Top">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="250" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Label VerticalAlignment="Center">FaultRecTimes</Label>
        <ComboBox Name="comboBox_FaultRestoreTimes" Grid.Column="1" Width="80" Height="25" HorizontalAlignment="Left" />
        <Label Grid.Row="1" VerticalAlignment="Center">ocp__da</Label>
        <StackPanel Name="panel_OcpDa" Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
          <TextBox Name="textBox_OcpDa" Width="80" Height="23" HorizontalAlignment="Left" ToolTip="range:0-255 integer" PreviewKeyUp="textBox_OcpDa_PreviewKeyUp" LostFocus="textBox_OcpDa_LostFocus" />
          <TextBlock Name="textBlock_OcpDa_Voltage" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" />
        </StackPanel>
        <Label Grid.Row="2" VerticalAlignment="Center">Uvp__Thr</Label>
        <Slider Name="slider_UvpThr" Grid.Row="2" Grid.Column="1" Width="250" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBox Name="textBox_UvpThr" Grid.Row="2" Grid.Column="2" Width="50" Height="23" HorizontalAlignment="Left" IsEnabled="False" />
        <Label Grid.Row="3" VerticalAlignment="Center">Ovp__Thr</Label>
        <Slider Name="slider_OvpThr" Grid.Row="3" Grid.Column="1" Width="250" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBox Name="textBox_OvpThr" Grid.Row="3" Grid.Column="2" Width="50" Height="23" HorizontalAlignment="Left" IsEnabled="False" />
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Grid.Column="0" Header="Lock Protection" Margin="0,310,0,0" Height="90">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Ton time</Label>
        <Slider Name="slider_HallLockSel" Grid.Row="0" Grid.Column="1" Width="270" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <TextBlock Name="textBlock_HallLockSel" Grid.Row="0" Grid.Column="1" Foreground="#FF000000" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" Text="{Binding ElementName=slider_HallLockSel, Path=Value, Mode=OneWay}" />
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Grid.Column="1" Header="Other Cfg" Margin="0,5,5,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="250" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label VerticalAlignment="Center">carrier__sel</Label>
        <UniformGrid Grid.Column="1" Rows="1" VerticalAlignment="Center">
          <RadioButton Name="radioBtn_CarrierSel0">25k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel1">42k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel2">16k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel3">20k</RadioButton>
        </UniformGrid>
        <Label Grid.Row="1" VerticalAlignment="Center">McOff__Sel</Label>
        <UniformGrid Grid.Row="1" Grid.Column="1" Rows="1" VerticalAlignment="Center">
          <RadioButton Name="radioBtn_McOffSel0">1.6s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel1">3.2s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel2">0s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel3">6.5s</RadioButton>
        </UniformGrid>
        <Label Grid.Row="2" VerticalAlignment="Center">thecomp__sel</Label>
        <Slider Name="slider_TheCompSel" Grid.Row="2" Grid.Column="1" Width="250" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBlock Name="textBox_TheCompSel" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Foreground="#FF000000" Text="{Binding ElementName=slider_TheCompSel, Path=Value, Mode=OneWay}" />
        <Label Grid.Row="3" VerticalAlignment="Center">Dir__Inv</Label>
        <UniformGrid Grid.Row="3" Grid.Column="1" Rows="1" VerticalAlignment="Center">
          <RadioButton Name="radioBtn_DirInv0">Disable</RadioButton>
          <RadioButton Name="radioBtn_DirInv1">Enable</RadioButton>
        </UniformGrid>
        <Label Grid.Row="4" VerticalAlignment="Center">Limit__Sel</Label>
        <Slider Name="slider_LimitSel" Grid.Row="4" Grid.Column="1" Width="250" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_LimitSel" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FF000000" Text="{Binding ElementName=slider_LimitSel, Path=Value, Mode=OneWay}" />
        <Label Name="label_cmpmodsel" Grid.Row="5" Width="90" VerticalAlignment="Center">cmp__modsel</Label>
        <ComboBox Name="comboBox_CmpModeSel" Grid.Row="5" Grid.Column="1" Width="120" Height="25" HorizontalAlignment="Left" />
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>