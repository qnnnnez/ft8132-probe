<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FT8215Debugger.OtherSettingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Advanced Setting" Height="450" Width="710" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" xmlns:ft8215debugger="clr-namespace:FT8215Debugger" Closing="Window_Closing">
  <Grid>
    <GroupBox Grid.Row="0" Header="Advanced Selection" Margin="0,2,0,2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="50" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Label Name="label_AOEK3" Grid.Row="0" Grid.Column="0" Margin="2,3,0,0">AO__ek3</Label>
        <Label Name="label_SegEn" Grid.Row="1" Grid.Column="0" Margin="2,3,0,0">SegEn</Label>
        <TextBox Name="textBox_MfpEk3" Grid.Column="1" Margin="2,0,0,0" Width="80" ToolTip="range:0.01-100.0 float" MaxLength="6" HorizontalAlignment="Left" Height="28" VerticalAlignment="Top" />
        <ComboBox Name="comboBox_Seg7En" Grid.Row="1" Grid.Column="1" Margin="2,3,0,2" Width="110" HorizontalAlignment="Left" />
        <Label Name="label_SPDBW" Grid.Row="2" Grid.Column="0" Margin="2,3,0,0">SPD__BW</Label>
        <Label Name="label_LeadAngle" Grid.Row="3" Grid.Column="0" Margin="2,3,0,0">LeadAngle</Label>
        <Label Name="label_EKNum" Grid.Row="4" Grid.Column="0" Margin="2,3,0,0">EKNum</Label>
        <Label Name="label_DTSEL" Grid.Row="5" Grid.Column="0" Margin="2,3,0,0">DT__SEL</Label>
        <Slider Name="slider_SPDBw" Grid.Row="2" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <Slider Name="slider_LeadAngle" Grid.Row="3" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <Slider Name="slider_EKNum" Grid.Row="4" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <Slider Name="slider_DTSEL" Grid.Row="5" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBlock Name="txtBlock_SpdBw" Grid.Row="2" Grid.Column="2" Margin="0,5,0,0" HorizontalAlignment="Left" Width="35" Text="{Binding ElementName=slider_SPDBw, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <TextBlock Name="txtBlock_LeadAngle" Grid.Row="3" Grid.Column="2" Margin="0,5,0,0" Width="35" HorizontalAlignment="Left" Text="{Binding ElementName=slider_LeadAngle, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Name="label_Angle" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" Width="15" Margin="0,1,5,0">°</Label>
        <TextBlock Name="txtBlock_EKNum" Grid.Row="4" Grid.Column="2" Margin="0,5,0,0" HorizontalAlignment="Left" Width="35" Text="{Binding ElementName=slider_EKNum, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <TextBlock Name="txtBlock_DTSEL" Grid.Row="5" Grid.Column="2" Margin="0,5,0,0" HorizontalAlignment="Left" Width="32" Text="{Binding ElementName=slider_DTSEL, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right" Width="22" Margin="0,1,0,0">us</Label>
        <Label Name="label_StaIncTime" Grid.Row="6" Grid.Column="0" Margin="2,3,0,0">StaIncTime</Label>
        <Label Name="label_PI_PERIOD" Grid.Row="7" Grid.Column="0" Margin="2,3,0,0">PI__PERIOD</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1">
          <RadioButton Name="radioButton_StaIncTime_1s" Margin="0,7,0,3" HorizontalAlignment="Left" Width="48">1s</RadioButton>
          <RadioButton Name="radioButton_StaIncTime_2s" Margin="0,7,0,3" HorizontalAlignment="Right" Width="48">2s</RadioButton>
          <RadioButton Name="radioButton_StaIncTime_4s" Margin="0,7,0,3" HorizontalAlignment="Left" Width="48">4s</RadioButton>
          <RadioButton Name="radioButton_StaIncTime_6s" Margin="0,7,0,3" HorizontalAlignment="Right" Width="48">6s</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1">
          <RadioButton Name="radioBtn_ITripEn0" Margin="0,6,0,3" Width="60">10ms</RadioButton>
          <RadioButton Name="radioBtn_ITripEn1" Margin="36,6,0,3" Width="60" HorizontalAlignment="Right">1ms</RadioButton>
        </StackPanel>
        <Label Name="label_RPD_Align" Grid.Row="0" Grid.Column="3" Margin="2,3,0,0">RPD_Align</Label>
        <Label Name="label_AlignDuty" Grid.Row="1" Grid.Column="3" Margin="2,3,0,0">AlignDuty</Label>
        <Label Name="label_AlignTime" Grid.Row="2" Grid.Column="3" Margin="2,3,0,0">AlignTime</Label>
        <ComboBox Name="comboBox_RPDAlign" Grid.Row="0" Grid.Column="4" Margin="2,0,0,0" Width="80" Height="27" HorizontalAlignment="Left" />
        <Slider Name="slider_AlignDuty" Grid.Column="4" Grid.Row="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="3,3,0,0" IsMoveToPointEnabled="True" Maximum="15" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_AlignDuty" Grid.Column="5" Grid.Row="1" Margin="5,0,0,0" Text="0" HorizontalAlignment="Left" Width="25" Height="28" VerticalAlignment="Center" />
        <Label Grid.Column="5" Grid.Row="1" HorizontalAlignment="Left" Margin="35,0,0,0" Width="20.677">%</Label>
        <Slider Name="slider_AlignTime" Grid.Column="4" Grid.Row="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="3,3,0,0" IsMoveToPointEnabled="True" Maximum="15" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_AlignTime" Grid.Column="5" Grid.Row="2" Margin="5,0,0,0" Text="0" HorizontalAlignment="Left" Width="25" Height="28" VerticalAlignment="Center" />
        <Label Grid.Column="5" Grid.Row="2" HorizontalAlignment="Left" Margin="35,0,10,0">s</Label>
        <Label Name="label_cmpModsel" Grid.Row="0" Grid.Column="4" Margin="90,3,0,0">cmp__modsel</Label>
        <ComboBox Name="comboBox_cmpModsel" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Margin="172,0,0,0" Width="85" Height="27" HorizontalAlignment="Left" SelectionChanged="comboBox_cmpModsel_SelectionChanged" />
        <Label Name="label_UvpThr" Grid.Row="3" Grid.Column="3" Margin="2,3,0,0">Uvp__Thr</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2">
          <Slider Name="slider_UvpThr" Width="200" IsSnapToTickEnabled="True" Margin="0,3,0,0" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
          <TextBox Name="textBox_UvpThr" Width="50" Margin="2" Height="28" IsEnabled="False" />
        </StackPanel>
        <Label Name="label_OvpThr" Grid.Row="4" Grid.Column="3" Margin="2,3,0,0">Ovp__Thr</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="4" Grid.ColumnSpan="2">
          <Slider Name="slider_OvpThr" Width="200" IsSnapToTickEnabled="True" Margin="0,3,0,0" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
          <TextBox Name="textBox_OvpThr" Width="50" Margin="2" Height="28" IsEnabled="False" />
        </StackPanel>
        <Label Name="label_ntcEn" Grid.Row="5" Grid.Column="3" Margin="2,3,0,0" Height="30" VerticalAlignment="Top">ntc__en</Label>
        <StackPanel Name="stack_ntcEn" Orientation="Horizontal" Grid.Row="5" Grid.Column="4">
          <RadioButton Name="radioBtn_EtcEn0" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_EtcEn1" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Name="label_carriersel" Grid.Row="6" Grid.Column="3" Margin="2,3,0,0">carrier__sel</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="2">
          <RadioButton Name="radioBtn_CarrierSel0" Width="65" VerticalAlignment="Center">25k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel1" Width="65" VerticalAlignment="Center">42k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel2" Width="65" VerticalAlignment="Center">16k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel3" VerticalAlignment="Center">20k</RadioButton>
        </StackPanel>
        <Label Name="label_McOffSel" Grid.Row="7" Grid.Column="3" Margin="2,3,0,0">McOff__Sel</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="4" Grid.ColumnSpan="2">
          <RadioButton Name="radioBtn_McOffSel0" Width="65" VerticalAlignment="Center">1.6s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel1" Width="65" VerticalAlignment="Center">3.2s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel2" Width="65" VerticalAlignment="Center">0s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel3" VerticalAlignment="Center">6.5s</RadioButton>
        </StackPanel>
        <Label Name="label_thecompSel" Grid.Row="8" Grid.Column="0">thecom__sel</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2">
          <Slider Name="slider_TheCompSel" Width="200" Margin="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
          <TextBlock Name="textBox_TheCompSel" Width="35" Margin="0,3,0,3" Text="{Binding ElementName=slider_TheCompSel, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Label Name="label_LimitSel" Grid.Row="8" Grid.Column="3">Limit__Sel</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="4" Grid.ColumnSpan="2">
          <Slider Name="slider_LimitSel" Width="200" Margin="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
          <TextBlock Name="textBlock_LimitSel" Margin="0,3,0,3" Width="35" Text="{Binding ElementName=slider_LimitSel, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </GroupBox>
  </Grid>
</Window>