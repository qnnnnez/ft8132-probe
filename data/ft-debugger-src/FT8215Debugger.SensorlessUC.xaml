<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FT8215Debugger.SensorlessUC" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="831" xmlns:ft8215debugger="clr-namespace:FT8215Debugger">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="1*" />
      <RowDefinition Height="1*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.6*" />
      <ColumnDefinition Width="1.2*" />
      <ColumnDefinition Width="1.2*" />
    </Grid.ColumnDefinitions>
    <GroupBox Name="groupBox_mortorHwParam" Grid.Row="0" Grid.Column="0" Header="Motor &amp; Hardware" Margin="0,0,2,0" Background="#D5DFE5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100*" />
          <ColumnDefinition Width="85*" />
        </Grid.ColumnDefinitions>
        <Label Name="label_JiDuiShu" FontSize="12" Margin="2,5,0,0">Pole-Pairs</Label>
        <Label Name="label_DianZu" Grid.Row="1" FontSize="12" Margin="2,5,0,0">Rs(Ω)</Label>
        <Label Name="label_DianGan" Grid.Row="2" FontSize="12" Margin="2,5,0,0">Ls(H)</Label>
        <Label Name="label_FanDianDongShi" Grid.Row="3" FontSize="12" Margin="2,5,0,0">Ke</Label>
        <Label Name="label_CaiYandDianZu" Grid.Row="4" FontSize="12" Margin="2,5,0,0">Rsample(Ω)</Label>
        <Label Name="label_FanDaBeiShu" Grid.Row="5" FontSize="12" Margin="2,5,0,0">Amp</Label>
        <TextBox Name="textBox_JiDuiShu" Grid.Row="0" Grid.Column="1" Margin="0,5,2,2" MaxLength="2" ToolTip="range:1-20 integer" />
        <TextBox Name="textBox_DianZu" Grid.Row="1" Grid.Column="1" Margin="0,5,2,2" ToolTip="range:0.000-200.0 float" MaxLength="9" />
        <TextBox Name="textBox_DianGan" Grid.Row="2" Grid.Column="1" Margin="0,5,2,2" ToolTip="range:0.000000-1.000000 float" MaxLength="9" />
        <TextBox Name="textBox_FanDianDongShi" Grid.Row="3" Grid.Column="1" Margin="0,5,2,2" ToolTip="range:0.0000-100.0000 float" MaxLength="11" />
        <TextBox Name="textBox_CaiYandDianZu" Grid.Row="4" Grid.Column="1" Margin="0,5,2,2" ToolTip="range:0.001-2.000 float" MaxLength="5" />
        <ComboBox Name="comboBox_FanDaBeiShu" Grid.Row="5" Grid.Column="1" Margin="0,4,2,3" Height="28" />
      </Grid>
    </GroupBox>
    <GroupBox Name="groupBox_FOCParamerters" Grid.Row="0" Grid.Column="1" Header="FOC &amp; FG &amp; RSD" Margin="0,0,0,0" Background="#D5DFE5" VerticalAlignment="Top">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52*" />
          <ColumnDefinition Width="125*" />
          <ColumnDefinition Width="33*" />
        </Grid.ColumnDefinitions>
        <Label Name="label_ATOBW" Grid.Row="0" Grid.Column="0" Margin="2,5,0,0">ATOBW</Label>
        <TextBox Name="textBox_AtoBw" Grid.Row="0" Grid.Column="1" Margin="0,2,0,0" ToolTip="range:0-200 integer" MaxLength="3" HorizontalAlignment="Left" Width="60" />
        <Label Name="label_BaseFreq" Grid.Row="1" Grid.Column="0" Margin="2,5,0,0">BaseFreq</Label>
        <Label Name="label_SampleTime" Grid.Row="2" Grid.Column="0" Margin="0,5,0,0">Sampletime</Label>
        <Label Name="label_TSMIN" Grid.Row="3" Grid.Column="0" Margin="2,5,0,0">TSMIN</Label>
        <Slider Name="slider_BaseFreq" Grid.Row="1" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <Slider Name="slider_SampleTime" Grid.Row="2" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBlock Name="txtBlock_BaseFreq" Grid.Row="1" Grid.Column="2" Width="30" Height="28" Foreground="#FF000000" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="0,4,0,0" Text="{Binding ElementName=slider_BaseFreq, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Name="label_BaseFrequnit" Grid.Row="1" Grid.Column="2" Margin="25,0,0,0" VerticalAlignment="Center" Height="28" Foreground="#FF000000">Hz</Label>
        <TextBlock Name="txtBlock_SampleTime" Grid.Row="2" Grid.Column="2" Margin="0,0,0,0" Width="35" Height="28" Foreground="#FF000000" HorizontalAlignment="Left" Padding="0,3,0,0" Text="{Binding ElementName=slider_SampleTime, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Slider Name="slider_TSMIN" Grid.Row="3" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="1,2,0,2" IsMoveToPointEnabled="True" Maximum="15" Foreground="#FFFF0000" />
        <TextBlock Name="txtBlock_TSMIN" Grid.Row="3" Grid.Column="2" Foreground="#FF000000" Padding="0,4,0,0" HorizontalAlignment="Left" Width="34" Text="{Binding ElementName=slider_TSMIN, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Name="label_SpdCtrlMode" Grid.Row="0" Grid.Column="1" Width="90" Margin="32,5,0,0">SpdCtrlMode</Label>
        <ComboBox Name="comboBox_SpdCtrlMD" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,2,10,2" Width="70" Height="27" HorizontalAlignment="Right" />
        <Label Name="label_FGDIV" Grid.Row="4" Grid.Column="0" Margin="2,5,0,0">FGDIV</Label>
        <ComboBox Name="comboBox_FgDiv" Grid.Row="4" Grid.Column="1" Width="80" Margin="1" Height="28" HorizontalAlignment="Left" />
        <Label Name="label_FGMUL" Grid.Row="4" Grid.Column="1" Margin="95,0,0,0" Width="55" HorizontalAlignment="Left">FGMUL</Label>
        <ComboBox Name="comboBox_FgMul" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,1.12,10,1.12" Width="70" HorizontalAlignment="Right" />
        <Label Name="label_RSDMode" Grid.Row="5" Grid.Column="0" Margin="2,5,0,0">RSDMode</Label>
        <ComboBox Name="comboBox_RSDMode" Grid.Row="5" Grid.Column="1" Width="80" Height="28" Margin="1" HorizontalAlignment="Left" />
        <Label Name="label_StaticSpeed" Grid.Row="6" Grid.Column="0" Margin="0,3,0,0">StaticSpeed</Label>
        <Slider Name="slider_StaticSpeed" Grid.Row="6" Grid.Column="1" Margin="1,3,0,0" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_StaticSpeed" Grid.Row="6" Grid.Column="2" Margin="0,4,1,1" Foreground="#FF000000" HorizontalAlignment="Right" Width="35" />
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Header="Protection&amp;Other" Margin="190,5,2,0" Background="#D5DFE5" VerticalAlignment="Top">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="45*" />
          <ColumnDefinition Width="130*" />
          <ColumnDefinition Width="30*" />
        </Grid.ColumnDefinitions>
        <Label Name="label_FaultRecTimes" Grid.Row="0" Grid.Column="0" Margin="2,0,0,0" Height="28">FaultRecTimes</Label>
        <ComboBox Name="comboBox_FaultRestoreTimes" Grid.Row="0" Grid.Column="1" Margin="0,0,0,2" Width="80" HorizontalAlignment="Left" />
        <Label Name="label_Lock0" Grid.Row="1" Grid.Column="0" Height="28" Margin="2,0,0,0">Lock0</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1">
          <RadioButton Name="radioBtn_Lock0Dis" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_Lock0En" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Name="label_Lock1" Grid.Row="2" Grid.Column="0" Margin="2,0,0,0" Height="28">Lock1</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
          <RadioButton Name="radioBtn_Lock1Dis" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_Lock1En" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Name="label_Lock2" Grid.Row="3" Grid.Column="0" Margin="2,0,0,0">Lock2</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
          <RadioButton Name="radioBtn_Lock2Dis" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_Lock2En" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Name="label_LockEmf" Grid.Row="4" Grid.Column="0" Margin="2,0,0,0">LockEmf</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
          <Slider Name="slider_LockEmf" Width="232" Margin="0,2,0,0" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
          <TextBox Name="TextBox_LockEmf" Width="60" Margin="2" IsReadOnly="True" Text="{Binding ElementName=slider_LockEmf, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Label Name="label_OcpDis" Grid.Row="5" Grid.Column="0" Margin="2,0,0,0" Height="28">Ocp__Dis</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1">
          <RadioButton Name="radioBtn_OcpDis0" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_OcpDis1" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Name="label_OcpDa" Grid.Row="6" Grid.Column="0" Margin="2,0,0,0">ocp__da</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1">
          <TextBox Name="textBox_OcpDa" Width="80" Margin="2" HorizontalAlignment="Left" ToolTip="range:0-255 integer" PreviewKeyUp="textBox_OcpDa_PreviewKeyUp" LostFocus="textBox_OcpDa_LostFocus" />
          <TextBlock Name="textBlock_OcpDa_Voltage" Text="voltage: 0 v" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" />
        </StackPanel>
        <Label Name="label_DirInv" Grid.Row="7" Grid.Column="0" Margin="2,0,0,0" Height="28">Dir__Inv</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.Column="1">
          <RadioButton Name="radioBtn_DirInv0" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_DirInv1" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Name="label_LockMinSpeed" Grid.Row="1" Grid.Column="1" Margin="2,0,0,0" HorizontalAlignment="Right">LockMinSpeed</Label>
        <TextBox Name="textBox_LockMinSpeed" Grid.Row="1" Grid.Column="2" Width="60" Margin="2" ToolTip="less than 1/4 speed base" MaxLength="6" HorizontalAlignment="Left" />
        <Label Name="label_LockMaxSpeed" Grid.Row="2" Grid.Column="1" Margin="2,0,0,0" HorizontalAlignment="Right">LockMaxSpeed</Label>
        <TextBox Name="textBox_LockMaxSpeed" Grid.Row="2" Grid.Column="2" Width="60" Margin="2" ToolTip="more than 1/2 speed base" MaxLength="6" HorizontalAlignment="Left" />
        <Button Name="btn_OtherSet" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,5,2" Height="25" Width="122" HorizontalAlignment="Right" Click="btn_OtherSet_Click">Advanced Options</Button>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="0" Grid.Column="2" Header="Startup" Margin="2,0,2,0" Background="#D5DFE5" VerticalAlignment="Top">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60*" />
          <ColumnDefinition Width="140*" />
        </Grid.ColumnDefinitions>
        <Label Name="label_ControlMode" Grid.Row="0" Grid.Column="0" Margin="2,5,0,0" Height="30">ControlMode</Label>
        <Label Name="label_StartCurrent" Grid.Row="1" Grid.Column="0" Margin="2,5,0,0" Height="30">StartCurrent</Label>
        <Label Name="label_EFREQAcc" Grid.Row="2" Grid.Column="0" Margin="2,5,0,0" Height="30">EFREQAcc</Label>
        <Label Name="labelEFREQMin" Grid.Row="3" Grid.Column="0" Margin="2,5,0,0" Height="30">EFREQMin</Label>
        <Label Name="label_CloSpeed" Grid.Row="4" Grid.Column="0" Margin="2,5,0,0" Height="30">CloSpeed</Label>
        <Label Name="label_EFREQHold" Grid.Row="5" Grid.Column="0" Margin="2,5,0,0" Height="30">EFREQHold</Label>
        <Label Name="label_StartDuty30" Grid.Row="1" Grid.Column="0" Margin="2,5,0,0" Visibility="Hidden">StartDuty</Label>
        <ComboBox Name="comboBox_ContrlMode" Grid.Row="0" Grid.Column="1" Margin="6,0,0,3" Height="28" Width="100" HorizontalAlignment="Left" />
        <TextBox Name="textBox_StartCurrent" Grid.Column="1" Grid.Row="1" Margin="6,4,0,1" Width="80" ToolTip="range:0.001-20.000 float" MaxLength="6" HorizontalAlignment="Left" />
        <TextBox Name="textBox_StartDuty30" Grid.Column="1" Grid.Row="1" Margin="6,4,0,0" Width="80" ToolTip="range:1-50 int" Text="0" MaxLength="6" Visibility="Hidden" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" />
        <Label Name="label_StartDutyUnit" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="100,4,0,0" Visibility="Hidden">% (range:0~50)</Label>
        <Slider Name="slider_EFreQAcc" Grid.Column="1" Grid.Row="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="1,3,0,0" Width="180" IsMoveToPointEnabled="True" HorizontalAlignment="Left" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_EFreQAcc" Grid.Column="1" Grid.Row="2" Margin="4,5,5,3" Width="30" Foreground="#FF000000" HorizontalAlignment="Right" Text="{Binding ElementName=slider_EFreQAcc, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Slider Name="slider_EFreQMin" Grid.Column="1" Grid.Row="3" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="1,3,0,0" Width="180" IsMoveToPointEnabled="True" HorizontalAlignment="Left" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_EFreQMin" Grid.Column="1" Grid.Row="3" Margin="3,5,15,5" Foreground="#FF000000" HorizontalAlignment="Right" Width="23" Text="{Binding ElementName=slider_EFreQMin, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">2.6</TextBlock>
        <Label Name="label32" Grid.Column="1" Grid.Row="3" Margin="0,0,1,0" HorizontalAlignment="Right" Width="19.949" Foreground="#FF000000">%</Label>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4">
          <RadioButton Name="radioButton_CloSpeed_0x" Margin="2,6,0,5" HorizontalAlignment="Left" Width="50">0.5x</RadioButton>
          <RadioButton Name="radioButton_CloSpeed_1x" Margin="2,6,0,5" Width="50">1x</RadioButton>
          <RadioButton Name="radioButton_CloSpeed_2x" Margin="2,6,0,5" Width="50" HorizontalAlignment="Right">2x</RadioButton>
          <RadioButton Name="radioButton_CloSpeed_4x" Margin="2,6,0,5" Width="50">4x</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="5">
          <RadioButton Name="radioButton_EFreQHold_1x" Margin="2,6,0,5" HorizontalAlignment="Left" Width="50">1x</RadioButton>
          <RadioButton Name="radioButton_EFreQHold_2x" Margin="2,6,0,5" Width="50">2x</RadioButton>
          <RadioButton Name="radioButton_EFreQHold_4x" Margin="2,6,0,5" HorizontalAlignment="Right" Width="50">4x</RadioButton>
          <RadioButton Name="radioButton_EFreQHold_8x" Margin="2,6,0,5" Width="50">8x</RadioButton>
        </StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox Name="groupBox_RunConfig" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Run" Margin="0,5,5,0" Width="355" HorizontalAlignment="Left">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="45*" />
          <ColumnDefinition Width="150*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Label Name="label_DQKP" Grid.Row="0" Grid.Column="0" Margin="1,0,0,0">DQ__KP</Label>
        <Label Name="label_DQKI" Grid.Row="1" Grid.Column="0" Margin="1,0,0,0">DQ__KI</Label>
        <Label Name="label_WKP" Grid.Row="2" Grid.Column="0" Margin="1,0,0,0">WKP</Label>
        <Label Name="label_WKI" Grid.Row="3" Grid.Column="0" Margin="1,0,0,0">WKI</Label>
        <Label Name="label_WOutMax" Grid.Row="4" Grid.Column="0" Margin="1,0,0,0">WOutMax</Label>
        <Label Name="label_StbInc" Grid.Row="5" Grid.Column="0" Margin="1,0,0,0">Stb__Inc</Label>
        <Label Name="label_StaInc" Grid.Row="6" Grid.Column="0" Margin="1,0,0,0">Sta__Inc</Label>
        <TextBox Name="textBox_DQKp" Grid.Column="1" Grid.Row="0" Margin="0,4,0,0" Width="80" ToolTip="range:0-4.0 float" MaxLength="7" HorizontalAlignment="Left" />
        <TextBox Name="textBox_DQKi" Grid.Column="1" Grid.Row="1" Margin="0,4,0,0" Width="80" ToolTip="range:0-0.500 float" MaxLength="7" HorizontalAlignment="Left" />
        <TextBox Name="textBox_WKp" Grid.Column="1" Grid.Row="2" Margin="0,4,0,0" Width="80" ToolTip="range:0-4.0 float" MaxLength="7" HorizontalAlignment="Left" />
        <TextBox Name="textBox_WKi" Grid.Column="1" Grid.Row="3" Margin="0,4,0,0" Width="80" ToolTip="range:0-0.500 float" MaxLength="7" HorizontalAlignment="Left" />
        <Slider Name="slider_WOutMax" Grid.Column="1" Grid.Row="4" Margin="0,2,3,9" Width="180" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" HorizontalAlignment="Left" Foreground="#FFFF0000" />
        <TextBox Name="textBox_WOutMax" Grid.Column="1" Grid.Row="4" Margin="3,4,53,6" HorizontalAlignment="Right" Width="31.104" ToolTip="range:0-63 integer" MaxLength="2" Text="{Binding ElementName=slider_WOutMax, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
        <Label Name="label42" Grid.Column="1" Grid.Row="4" Margin="0,2,0,6" HorizontalAlignment="Right" Width="20" Foreground="#FF000000">%</Label>
        <TextBlock Name="textBlock_WOutMax" Grid.Column="1" Grid.Row="4" Margin="0,5,18,6" HorizontalAlignment="Right" Foreground="#FF000000">0.000</TextBlock>
        <Slider Name="slider_StbInc" Grid.Column="3" Grid.Row="5" Margin="2,5,30,6" TickPlacement="BottomRight" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <Slider Name="slider_StaInc" Grid.Column="3" Grid.Row="6" Margin="2,5,30,6" TickPlacement="BottomRight" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Foreground="#FFFF0000" />
        <TextBlock Name="textBlock_StbInc" Grid.Column="4" Grid.Row="5" Margin="0,5,2,1" Foreground="#FF000000" HorizontalAlignment="Right" Width="25" Text="{Binding ElementName=slider_StbInc, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">31</TextBlock>
        <TextBlock Name="textBlock_StaInc" Grid.Column="4" Grid.Row="6" Margin="0,6,2,1" Foreground="#FF000000" HorizontalAlignment="Right" Width="25" Text="{Binding ElementName=slider_StaInc, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">31</TextBlock>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>