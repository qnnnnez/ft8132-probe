<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FT8215Debugger.MyStartupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FT8132StartupWindow" Height="350" Width="500" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" xmlns:ft8215debugger="clr-namespace:FT8215Debugger">
  <Grid>
    <Border CornerRadius="10">
      <Rectangle RadiusX="0" RadiusY="0">
        <Shape.Fill>
          <ImageBrush ImageSource="UIConfigFile\Images\png\BackgroundPicture.png" />
        </Shape.Fill>
      </Rectangle>
    </Border>
    <Border Margin="10,25,10,25" Background="#FF808080" Opacity="0.5" />
    <StackPanel Margin="10,10,10,0">
      <BulletDecorator Margin="5,25,5,0">
        <BulletDecorator.Bullet>
          <RadioButton Name="radioButton_Sensor" Content="Sensor" GroupName="SensorMode" Width="100" FontSize="14" Background="#FFFFE4C4" Foreground="#FFCA18" Checked="radioButton_Sensor_Checked" />
        </BulletDecorator.Bullet>
        <ComboBox Name="comboBox_Sensor_CircuitType" Height="30" Background="#FF20B2AA" VerticalContentAlignment="Center" SelectionChanged="comboBox_Sensor_CircuitType_SelectionChanged" />
      </BulletDecorator>
      <BulletDecorator Margin="5,15,5,0">
        <BulletDecorator.Bullet>
          <RadioButton Name="radioButton_Sensorless" Content="Sensorless" GroupName="SensorMode" Width="100" FontSize="14" Background="#FFFFE4C4" Foreground="#FFCA18" Checked="radioButton_Sensorless_Checked" />
        </BulletDecorator.Bullet>
        <ComboBox Name="comboBox_Sensorless_CircuitType" Height="30" Background="#FF20B2AA" VerticalContentAlignment="Center" SelectionChanged="comboBox_Sensorless_CircuitType_SelectionChanged" />
      </BulletDecorator>
      <RadioButton Name="radionButton_Full" Content="Full" GroupName="SensorMode" Margin="5,15,0,0" FontSize="14" Background="#FFFFE4C4" Foreground="#FFCA18" Checked="radionButton_Full_Checked" />
      <RadioButton Name="radioButton_2Hall_ICCoolFan" Content="2HALL IC Cooling Fan" GroupName="SensorMode" Margin="5,15,0,0" FontSize="14" Background="#FFFFE4C4" Foreground="#FFCA18" Checked="radioButton_2Hall_ICCoolFan_Checked" />
      <RadioButton Name="radioButton_RoboticVacuum" Content="Robotic Vacuum" GroupName="SensorMode" Margin="5,15,0,0" FontSize="14" Background="#FFFFE4C4" Foreground="#FFCA18" Checked="radioButton_RoboticVacuum_Checked" />
      <Button Name="button_Confirm" Content="Confirm" Height="45" Width="85" Margin="0,15,0,0" FontSize="16" Background="#FF20B2AA" Click="button_Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>