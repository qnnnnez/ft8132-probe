<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="FT8215Debugger.UC_2Hall_sensor_2Res_FOC_AS" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="495" Width="830" xmlns:ft8215debugger="clr-namespace:FT8215Debugger">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="507*" />
      <RowDefinition Height="360*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="126*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>
    <GroupBox Name="groupBox_TempParamCfg" Grid.Row="0" Grid.Column="0" Header="HallParamCfg" Margin="0,4,0,0" Background="#D5DFE5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80*" />
          <ColumnDefinition Width="140*" />
          <ColumnDefinition Width="30*" />
        </Grid.ColumnDefinitions>
        <Label Name="label115" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">hall__md</Label>
        <ComboBox Name="comboBox_HallMode" Grid.Row="0" Grid.Column="1" Width="120" Height="28" HorizontalAlignment="Left" />
        <Label Name="label_HallComMd" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">hall__com__md</Label>
        <Label Name="label117" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">hall0__rev__en</Label>
        <Label Name="label118" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">hall1__rev__en</Label>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2">
          <RadioButton Name="radioBtn_HallComMd0" Grid.Column="1" Grid.Row="2" Margin="0,9,0,6" HorizontalAlignment="Left" Width="40">0</RadioButton>
          <RadioButton Name="radioBtn_HallComMd1" Grid.Column="1" Grid.Row="2" Margin="0,9,0,6" HorizontalAlignment="Left" Width="45">-30</RadioButton>
          <RadioButton Name="radioBtn_HallComMd3" Grid.Column="1" Grid.Row="2" Margin="0,9,0,6" HorizontalAlignment="Left" Width="40">30</RadioButton>
          <RadioButton Name="radioBtn_HallComMd2" Grid.Column="1" Grid.Row="2" Margin="0,9,0,6" HorizontalAlignment="Left" Width="40" Visibility="Hidden">-60</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="3">
          <RadioButton Name="radioBtn_Hall0RevDis" Grid.Column="1" Grid.Row="3" Margin="0,9,0,5" Width="70">Disable</RadioButton>
          <RadioButton Name="radioBtn_Hall0RevEn" Grid.Column="1" Grid.Row="3" Margin="0,9,0,5" Width="70">Enable</RadioButton>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4">
          <RadioButton Name="radioBtn_Hall1RevDis" Grid.Column="1" Grid.Row="4" Margin="0,9,0,5" Width="70">Disable</RadioButton>
          <RadioButton Name="radioBtn_Hall1RevEn" Grid.Column="1" Grid.Row="4" Margin="0,9,0,5" Width="70">Enable</RadioButton>
        </StackPanel>
        <Label Name="label125" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">hall__lock__sel</Label>
        <Label Name="label126" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center">hall__swi__md</Label>
        <Slider Name="slider_HallLockSel" Grid.Column="1" Grid.Row="5" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" HorizontalAlignment="Left" Width="162" VerticalAlignment="Center" />
        <TextBlock Name="textBlock_HallLockSel" Grid.Column="2" Grid.Row="5" Margin="5,6,0,0" Text="{Binding ElementName=slider_HallLockSel, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Slider Name="slider_HallSwiMd" Grid.Column="1" Grid.Row="6" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="textBlock_HallSwiMd" Grid.Column="2" Grid.Row="6" Margin="5,3,0,0" Text="0" />
        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">hall__modsel</Label>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton Name="radioBtn_HallIC" Width="70" Checked="radioBtn_HallIC_Checked">IC</RadioButton>
          <RadioButton Name="radioBtn_HallSensor" Width="70" Checked="radioBtn_HallSensor_Checked">sensor</RadioButton>
        </StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox Name="groupBox_mortorHwParam" Grid.Row="0" Grid.Column="1" Header="Motor&amp;Hardware" Margin="0,4,0,0" Background="#D5DFE5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="87*" />
          <ColumnDefinition Width="108*" />
        </Grid.ColumnDefinitions>
        <Label Name="label_JiDuiShu" Grid.Row="0" VerticalAlignment="Center">Pole-Pairs</Label>
        <Label Name="label_DianZu" Grid.Row="1" VerticalAlignment="Center">Rs(Ω)</Label>
        <Label Name="label_DianGan" Grid.Row="2" VerticalAlignment="Center">Ls(H)</Label>
        <Label Name="label_FanDianDongShi" Grid.Row="3" VerticalAlignment="Center">Ke</Label>
        <Label Name="label_CaiYandDianZu" Grid.Row="4" VerticalAlignment="Center">Rsample(Ω)</Label>
        <Label Name="label_FanDaBeiShu" Grid.Row="5" VerticalAlignment="Center">Amp</Label>
        <TextBox Name="textBox_JiDuiShu" Grid.Row="0" Grid.Column="1" Margin="4,5,5,2" MaxLength="2" ToolTip="range:1-20 integer" />
        <TextBox Name="textBox_DianZu" Grid.Row="1" Grid.Column="1" Margin="4,5,5,2" ToolTip="range:0.000-200.0 float" MaxLength="9" />
        <TextBox Name="textBox_DianGan" Grid.Row="2" Grid.Column="1" Margin="4,5,5,2" ToolTip="range:0.000000-1.000000 float" MaxLength="9" />
        <TextBox Name="textBox_FanDianDongShi" Grid.Row="3" Grid.Column="1" Margin="4,5,5,2" ToolTip="range:0.0000-100.0000 float" MaxLength="11" />
        <TextBox Name="textBox_CaiYandDianZu" Grid.Row="4" Grid.Column="1" Margin="4,5,5,0" ToolTip="range:0.001-2.000 float" MaxLength="5" Height="24.214" VerticalAlignment="Top" />
        <ComboBox Name="comboBox_FanDaBeiShu" Grid.Row="5" Grid.Column="1" Margin="4,4,5,3" />
      </Grid>
    </GroupBox>
    <GroupBox Name="groupBox_FOCParamerters" Grid.Row="0" Grid.Column="2" Header="FOC &amp; RSD" Margin="0,4,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
          <RowDefinition Height="27*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="73*" />
          <ColumnDefinition Width="130*" />
          <ColumnDefinition Width="40*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">ATOBW</Label>
        <TextBox Name="textBox_AtoBw" Grid.Row="0" Grid.Column="1" Margin="5,5,0,0" ToolTip="range:0-200 integer" MaxLength="3" HorizontalAlignment="Left" Width="80" />
        <Label Name="label10" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">BaseFreq</Label>
        <Slider Name="slider_BaseFreq" Grid.Row="1" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="txtBlock_BaseFreq" Grid.Row="1" Grid.Column="2" Margin="0,0,18,0" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding ElementName=slider_BaseFreq, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Name="label_BaseFreq" Grid.Row="1" Grid.Column="2" Margin="0,0,1,0" HorizontalAlignment="Right" Width="24" VerticalAlignment="Center">Hz</Label>
        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">DT__SEL</Label>
        <Slider Name="slider_DTSEL" Grid.Row="2" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="txtBlock_DTSEL" Grid.Row="2" Grid.Column="2" Margin="0,0,18,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding ElementName=slider_DTSEL, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Name="label_DTSEL" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Width="22" VerticalAlignment="Center">us</Label>
        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">SpdCtrlMode</Label>
        <ComboBox Name="comboBox_SpdCtrlMD" Grid.Row="3" Grid.Column="1" Margin="5,5,0,0" Width="100" Height="28" HorizontalAlignment="Left" />
        <Label Name="label80" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">RSDMode</Label>
        <ComboBox Name="comboBox_RSDMode" Grid.Row="4" Grid.Column="1" Margin="5,5,0,0" Width="100" Height="28" HorizontalAlignment="Left" />
        <Label Name="label82" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">StaticSpeed</Label>
        <Slider Name="slider_StaticSpeed" Grid.Row="5" Grid.Column="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="textBlock_StaticSpeed" Grid.Row="5" Grid.Column="2" Margin="0,4,1,1" HorizontalAlignment="Right" Width="32" />
        <Button Name="btn_Advanced" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,10,0" Width="80" Height="28" HorizontalAlignment="Right" Click="btn_Advanced_Click">Advanced</Button>
      </Grid>
    </GroupBox>
    <GroupBox Name="groupBox_RunConfig" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Run &amp; Startup" Margin="0,3,0,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="87" />
          <ColumnDefinition Width="126" />
          <ColumnDefinition Width="152.796*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
        </Grid.RowDefinitions>
        <Label Name="label33" Grid.Column="0" Margin="1,0,0,0">DQ__KP</Label>
        <Label Name="label34" Grid.Row="1" Grid.Column="0" Margin="1,0,0,0">DQ__KI</Label>
        <Label Name="label35" Grid.Row="2" Grid.Column="0" Margin="1,0,0,0">WKP</Label>
        <Label Name="label36" Grid.Row="3" Grid.Column="0" Margin="1,0,0,0">WKI</Label>
        <Label Name="label37" Grid.Row="4" Grid.Column="0" Margin="1,0,0,0">WOutMax</Label>
        <Label Name="label39" Grid.Row="0" Grid.Column="2" Margin="0,0,0,0">Stb__Inc</Label>
        <Label Name="label40" Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">Sta__Inc</Label>
        <TextBox Name="textBox_DQKp" Grid.Column="1" Grid.Row="0" Margin="0,4,5,5" ToolTip="range:0-4.0 float" MaxLength="7" />
        <TextBox Name="textBox_DQKi" Grid.Column="1" Grid.Row="1" Margin="0,4,5,5" ToolTip="range:0-0.500 float" MaxLength="7" />
        <TextBox Name="textBox_WKp" Grid.Column="1" Grid.Row="2" Margin="0,4,5,5" ToolTip="range:0-4.0 float" MaxLength="7" />
        <TextBox Name="textBox_WKi" Grid.Column="1" Grid.Row="3" Margin="0,4,5,5" ToolTip="range:0-0.500 float" MaxLength="7" />
        <Slider Name="slider_WOutMax" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="4" Margin="4,2,3,9" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" />
        <Slider Name="slider_StbInc" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="0" Margin="2,5,30,6" TickPlacement="BottomRight" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" />
        <Slider Name="slider_StaInc" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="1" Margin="2,5,30,6" TickPlacement="BottomRight" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" />
        <TextBlock Name="textBlock_StbInc" Grid.Column="4" Grid.Row="0" Margin="0,5,2,1" HorizontalAlignment="Right" Width="25" Text="{Binding ElementName=slider_StbInc, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">31</TextBlock>
        <TextBlock Name="textBlock_StaInc" Grid.Column="4" Grid.Row="1" Margin="0,6,2,1" HorizontalAlignment="Right" Width="25" Text="{Binding ElementName=slider_StaInc, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">31</TextBlock>
        <TextBox Name="textBox_WOutMax" Grid.Column="4" Grid.Row="4" Margin="3,4,0,6" HorizontalAlignment="Left" Width="31.104" ToolTip="range:0-63 integer" MaxLength="2" Text="{Binding ElementName=slider_WOutMax, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
        <Label Name="label42" Grid.Column="4" Grid.Row="4" Margin="0,2,40,3" HorizontalAlignment="Right" Width="20">%</Label>
        <TextBlock Name="textBlock_WOutMax" Grid.Column="4" Grid.Row="4" Margin="41,8,17,10">0.000</TextBlock>
        <Label Name="label24" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">ControlMode</Label>
        <Label Name="label25" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">StartCurrent</Label>
        <Label Name="label_StartDuty30" Grid.Row="3" Grid.Column="2" Visibility="Hidden" VerticalAlignment="Center">StartDuty</Label>
        <ComboBox Name="comboBox_ContrlMode" Grid.Row="2" Grid.Column="3" Width="100" Height="28" Margin="5,0,0,0" HorizontalAlignment="Left" />
        <TextBox Name="textBox_StartCurrent" Grid.Column="3" Grid.Row="3" Margin="5,4,0,2" Width="100" ToolTip="range:0.001-20.000 float" MaxLength="6" HorizontalAlignment="Left" />
        <TextBox Name="textBox_StartDuty30" Grid.Column="3" Grid.Row="3" Margin="6,4,0,2" Width="100" ToolTip="range:1-50 int" Text="0" MaxLength="6" HorizontalAlignment="Left" Visibility="Hidden" />
        <Label Name="label_StartDutyUnit" Grid.Column="3" Grid.Row="3" Grid.ColumnSpan="2" Margin="110,4,0,0" Visibility="Hidden" VerticalAlignment="Center">% (range:0~50)</Label>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Grid.Column="2" Header="FG &amp; Protection">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
          <RowDefinition Height="12*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60*" />
          <ColumnDefinition Width="180*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">FGDIV</Label>
        <ComboBox Name="comboBox_FgDiv" Grid.Row="0" Grid.Column="1" Width="80" Height="28" HorizontalAlignment="Left" />
        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">FGMUL</Label>
        <ComboBox Name="comboBox_FgMul" Grid.Row="1" Grid.Column="1" Width="80" Height="28" HorizontalAlignment="Left" />
        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Ocp__Dis</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1">
          <RadioButton Name="radioBtn_OcpDis0" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_OcpDis1" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">ocp__da</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
          <TextBox Name="textBox_OcpDa" Width="80" Height="28" HorizontalAlignment="Left" ToolTip="range:0-255 integer" PreviewKeyUp="textBox_OcpDa_PreviewKeyUp" LostFocus="textBox_OcpDa_LostFocus" />
          <TextBlock Name="textBlock_OcpDa_Voltage" Text="voltage: 0 v" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" />
        </StackPanel>
        <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Center">Dir__Inv</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
          <RadioButton Name="radioBtn_DirInv0" Width="75" VerticalAlignment="Center">Disable</RadioButton>
          <RadioButton Name="radioBtn_DirInv1" VerticalAlignment="Center">Enable</RadioButton>
        </StackPanel>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>