<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="FT8215Debugger.Sensor_AdvancedSettingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Advanced Setting" Height="400" Width="750" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" xmlns:ft8215debugger="clr-namespace:FT8215Debugger" Closing="Window_Closing">
  <Grid>
    <GroupBox Grid.Row="0" Header="Advanced Selection" Margin="0,2,0,2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
          <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.7*" />
          <ColumnDefinition Width="1.8*" />
          <ColumnDefinition Width="0.5*" />
          <ColumnDefinition Width="1.0*" />
          <ColumnDefinition Width="2.0*" />
          <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>
        <Label Name="label6" Grid.Row="0" Margin="2,0,0,0" VerticalAlignment="Center">SegEn</Label>
        <ComboBox Name="comboBox_Seg7En" Grid.Row="0" Grid.Column="1" Margin="2,2,0,2" Width="100" HorizontalAlignment="Left" />
        <Label Name="label12" Grid.Row="1" Grid.Column="0" Margin="2,0,0,0" VerticalAlignment="Center">SPD__BW</Label>
        <Slider Name="slider_SPDBw" Grid.Row="1" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="0,2,0,2" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="txtBlock_SpdBw" Grid.Row="1" Grid.Column="2" Margin="14,4.518,0,4.518" HorizontalAlignment="Left" Width="7.408" Text="{Binding ElementName=slider_SPDBw, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Grid.Row="2" Grid.Column="0" Margin="2,0,0,0" VerticalAlignment="Center">TSMIN</Label>
        <Slider Name="slider_TSMIN" Grid.Row="2" Grid.Column="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="0,2,0,2" IsMoveToPointEnabled="True" Maximum="15" Foreground="#FFFF0000" VerticalAlignment="Center" />
        <TextBlock Name="txtBlock_TSMIN" Grid.Row="2" Grid.Column="2" Margin="14,4.979,0,4.979" HorizontalAlignment="Left" Width="20" Text="{Binding ElementName=slider_TSMIN, Path=Value, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
        <Label Name="label27" Grid.Row="3" Grid.Column="0" Margin="2,0,0,0" VerticalAlignment="Center">EFREQMin</Label>
        <Slider Name="slider_EFreQMin" Grid.Column="1" Grid.Row="3" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="1,1,0,4" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="textBlock_EFreQMin" Grid.Column="2" Grid.Row="3" Margin="13,3,0,5" HorizontalAlignment="Left" Width="23" Text="{Binding ElementName=slider_EFreQMin, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">2.6</TextBlock>
        <Label Name="label32" Grid.Column="2" Grid.Row="3" Margin="0,0,1,0" HorizontalAlignment="Right" Width="19.949">%</Label>
        <Label Name="label28" Grid.Row="4" Grid.Column="0" Margin="2,0,0,0" VerticalAlignment="Center">CloSpeed</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
          <RadioButton Name="radioButton_CloSpeed_0x" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" Width="50" VerticalAlignment="Center">0.5x</RadioButton>
          <RadioButton Name="radioButton_CloSpeed_1x" Grid.Column="1" Grid.Row="4" Width="50" VerticalAlignment="Center">1x</RadioButton>
          <RadioButton Name="radioButton_CloSpeed_2x" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Right" Width="50" VerticalAlignment="Center">2x</RadioButton>
          <RadioButton Name="radioButton_CloSpeed_4x" Grid.Column="2" Grid.Row="4" Width="50" VerticalAlignment="Center">4x</RadioButton>
        </StackPanel>
        <Label Grid.Row="0" Grid.Column="3" VerticalAlignment="Center">FaultRecTimes</Label>
        <ComboBox Name="comboBox_FaultRestoreTimes" Grid.Row="0" Grid.Column="4" Width="100" Margin="2,2,0,2" HorizontalAlignment="Left" />
        <Label Grid.Row="1" Grid.Column="3" VerticalAlignment="Center">Uvp__Thr</Label>
        <Slider Name="slider_UvpThr" Grid.Row="1" Grid.Column="4" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBox Name="textBox_UvpThr" Grid.Row="1" Grid.Column="5" IsEnabled="False" Height="28" />
        <Label Grid.Row="2" Grid.Column="3" VerticalAlignment="Center">Ovp__Thr</Label>
        <Slider Name="slider_OvpThr" Grid.Row="2" Grid.Column="4" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBox Name="textBox_OvpThr" Grid.Row="2" Grid.Column="5" IsEnabled="False" Height="28" />
        <Label Grid.Row="3" Grid.Column="3" VerticalAlignment="Center">carrier__sel</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="4">
          <RadioButton Name="radioBtn_CarrierSel0" Width="60" VerticalAlignment="Center">25k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel1" Width="60" VerticalAlignment="Center">42k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel2" Width="60" VerticalAlignment="Center">16k</RadioButton>
          <RadioButton Name="radioBtn_CarrierSel3" VerticalAlignment="Center">20k</RadioButton>
        </StackPanel>
        <Label Grid.Row="4" Grid.Column="3" VerticalAlignment="Center">McOff__Sel</Label>
        <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="4">
          <RadioButton Name="radioBtn_McOffSel0" Width="60" VerticalAlignment="Center">1.6s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel1" Width="60" VerticalAlignment="Center">3.2s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel2" Width="60" VerticalAlignment="Center">0s</RadioButton>
          <RadioButton Name="radioBtn_McOffSel3" VerticalAlignment="Center">6.5s</RadioButton>
        </StackPanel>
        <Label Grid.Row="5" Grid.Column="3" VerticalAlignment="Center">thecomp__sel</Label>
        <Slider Name="slider_TheCompSel" Grid.Row="5" Grid.Column="4" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="textBox_TheCompSel" Grid.Row="5" Grid.Column="5" VerticalAlignment="Center" Text="{Binding ElementName=slider_TheCompSel, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Label Grid.Row="5" Grid.Column="0" VerticalAlignment="Center">Limit__Sel</Label>
        <Slider Name="slider_LimitSel" Grid.Row="5" Grid.Column="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" IsMoveToPointEnabled="True" VerticalAlignment="Center" />
        <TextBlock Name="textBlock_LimitSel" Grid.Row="5" Grid.Column="2" Margin="14,4.518,0,4.518" VerticalAlignment="Center" Text="{Binding ElementName=slider_LimitSel, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </GroupBox>
  </Grid>
</Window>